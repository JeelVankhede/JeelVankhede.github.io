# Dev.to API key — required by scripts/crosspost.mjs
# Get at: https://dev.to/settings/extensions → DEV Community API Keys
DEVTO_API_KEY=your_dev_to_api_key_here

# CoderLegion API key — required by scripts/coderlegion.mjs
# Get at: https://coderlegion.com/api-keys (Pro account → Personal API Key)
CODERLEGION_API_KEY=your_coderlegion_api_key_here
